  "/features/features.17/conv/conv.1/conv.1.2/Clip" -> "/features/features.17/conv/conv.2/Conv";
  "/features/features.17/conv/conv.2/Conv" -> "/features/features.18/features.18.0/Conv";
  "/features/features.18/features.18.0/Conv" -> "/features/features.18/features.18.2/Clip";
  "/features/features.18/features.18.2/Clip" -> "/GlobalAveragePool";
  "/GlobalAveragePool" -> "/Flatten";
  "/Flatten" -> "/classifier/classifier.1/Gemm";
  "out::output" [label="output\nbatch_sizex10" fillcolor="#dce4ec" fontsize=12];
  "/classifier/classifier.1/Gemm" -> "out::output";
}